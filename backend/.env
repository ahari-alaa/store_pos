# Security
BCRYPT_SALT_ROUNDS=12
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
CORS_ORIGIN=*

# First admin (used only by scripts/seedAdmin.js)
SEED_ADMIN_EMAIL=azizsaif@StorePOS.com
SEED_ADMIN_PASSWORD=20031509
SEED_ADMIN_PIN=200399
SEED_ADMIN_NAME=Store Admin
SEED_STORE_NAME=Main Store

# Cashier PIN login (see migrations/010_pin_authentication.sql).
# Keep this as secret as JWT_SECRET — it is the key used to look a user
# up by their PIN. Generate one with: openssl rand -hex 32
PIN_PEPPER=200399
PIN_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
PIN_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8

# Optional: give the seeded admin a PIN too, so they can sign into the
# PIN-only Flutter login screen without a separate email/password step.
# Must be 4-6 digits. Leave unset to skip.
# SEED_ADMIN_PIN=1234
